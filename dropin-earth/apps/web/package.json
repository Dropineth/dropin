{
  "name": "@dropin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "preopennext:build": "node scripts/clean-opennext-build.mjs",
    "opennext:build": "opennextjs-cloudflare build && node scripts/promote-static-homepage.mjs",
    "opennext:preview": "opennextjs-cloudflare preview",
    "opennext:deploy": "opennextjs-cloudflare deploy",
    "opennext:upload": "opennextjs-cloudflare upload",
    "cf:build": "npm run opennext:build",
    "cf:preview": "npm run opennext:preview",
    "cf:deploy": "npm run opennext:deploy",
    "cf:upload": "npm run opennext:upload",
    "build:cloudflare": "npm run cf:build",
    "deploy:cloudflare": "npm run cf:deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:lifepp": "cd ../.. && node --test --import tsx tests/unit/lifepp-*.test.ts",
    "test:lifepp:browser": "cd ../.. && node scripts/lifepp-browser-check.mjs",
    "cf:preview:lifepp": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8788"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@dropin/dropin-protocol": "file:../../packages/dropin-protocol",
    "@dropin/schemas": "file:../../packages/schemas",
    "@dropin/ui": "file:../../packages/ui",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.4.1",
    "next": "15.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.4"
    },
    "@opennextjs/aws": {
      "esbuild": "0.28.1"
    },
    "wrangler": {
      "esbuild": "0.28.1"
    },
    "miniflare": {
      "ws": "8.21.0"
    }
  }
}
