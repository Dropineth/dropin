              "environment",
              "audience",
              "nonce",
              "sessionId",
              "issuedAt",
              "expiresAt",
              "anchor",
              "registry"
            ],
            "additionalProperties": false
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        },
        "required": [
          "payload",
          "signature"
        ],
        "additionalProperties": false
      },
      "Registry": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_-]{1,160}$"
          },
          "keys": {
            "minItems": 2,
            "maxItems": 8,
