          }
        },
        "required": [
          "resumeTicket"
        ],
        "additionalProperties": false,
        "description": "Existing synthetic resume/cancel-resume body; possession ticket, not IdP identity recovery. Bad ticket string shape is rejected by store with 401."
      },
      "ProviderError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "UNAVAILABLE",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
