                "additionalProperties": false
              },
              "registry": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9:_-]{1,160}$"
                  },
                  "keys": {
                    "minItems": 2,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "keyId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9:_-]{1,160}$"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
