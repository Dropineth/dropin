{
  "openapi": "3.1.0",
  "info": {
    "title": "AHIN Signer Profile v1 — CanopyProof synthetic integration contract",
    "version": "1.0.0",
    "description": "Product-local contract export. Not an approved AHIN wire/signing profile or production guardian authority. See README.md for mandatory signing and semantic validation."
  },
  "x-authority-status": "SIMULATION_ONLY; no production authority established",
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "Isolated fixture handler only; not a deployed service",
      "variables": {
        "port": {
          "default": "8080"
        }
      }
    }
  ],
  "paths": {
    "/current": {
      "post": {
        "operationId": "readSyntheticCurrentRestoreAuthority",
        "x-implementation-status": "unmounted fixture handler",
        "description": "Nonce-bound signed current snapshot. No standalone revocation-list or recovery API is implemented.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurrentAuthorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed snapshot; client must verify all semantic rules",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Fixture error; caller treats every non-200 as unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          },
          "404": {
            "description": "Fixture error; caller treats every non-200 as unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          },
          "405": {
            "description": "Fixture error; caller treats every non-200 as unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          },
          "503": {
            "description": "Fixture error; caller treats every non-200 as unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentAuthorityRequest": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "const": "CanopyProof-CurrentRestoreAuthority/1"
          },
          "environment": {
            "type": "string",
            "const": "SIMULATION_ONLY"
          },
          "audience": {
            "type": "string"
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "protocol",
          "environment",
          "audience",
          "nonce",
          "sessionId"
        ],
        "additionalProperties": false
      },
      "SignedSnapshot": {
        "type": "object",
        "properties": {
          "payload": {
