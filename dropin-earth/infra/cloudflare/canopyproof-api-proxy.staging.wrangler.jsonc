{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "canopyproof-api-staging",
  "main": "../../packages/dropin-cloudflare/src/canopyproof-api-proxy.ts",
  "compatibility_date": "2026-06-17",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "DROPIN_API_ORIGIN": "https://canopyproof-staging-origin.invalid",
    "DROPIN_ALLOWED_ORIGINS": "https://canopyproof-web-staging.invalid",
    "DROPIN_ALLOW_ADMIN_PROXY": "false",
    "DROPIN_CANONICAL_HOST": "canopyproof-api-staging.invalid",
    "DROPIN_CANOPYPROOF_MODE": "testnet",
    "CANOPYPROOF_EDGE_OTEL_EXPORT_ENABLED": "false",
    "CANOPYPROOF_EDGE_OTEL_SAMPLE_RATIO": "0"
  }
}
